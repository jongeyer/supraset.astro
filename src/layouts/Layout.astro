---
import '../styles/base.css'
import '../styles/transitions.css'
import { Tooltips } from 'astro-tooltips'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import NavigationDesktop from '@/components/NavigationDesktop.astro'
import NavigationMobile from '@/components/NavigationMobile.astro'
import Personalizer from '@/components/Personalizer.astro'
import Stats from '@/components/stats/Stats.astro'
import { textLinks } from '@/utils/navigation'
import {
  bandDurationMs,
  person,
  siteName,
  structuredData,
  tagline,
} from '@/utils/site'

interface Props {
  title?: string
  /** Home page mode: full-width hero instead of the header, no personalizer */
  hero?: boolean
  description?: string
  /** Keep the page out of search results, e.g. the 404 page */
  noindex?: boolean
  /** Hide the personalizer on pages with no content to personalize */
  hidePersonalizer?: boolean
}

const { title, hero, hidePersonalizer, noindex } = Astro.props
const description = Astro.props.description ?? `${person.name} - ${tagline}`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL = new URL('/og-image.png', Astro.site)
const jsonLd = JSON.stringify(structuredData(new URL('/', Astro.site)))
const navOrder = textLinks.map(link => link.href)
const formattedTitle = `${title || 'Supraset'} ≈ Jonathan Geyer`
const formattedStyles = `
  ${hero ? '' : 'grid h-screen overflow-auto'}
  min-h-screen
  text-zorba-200 [.theme-light_&]:text-zorba-800
`
---

<!doctype html>
<html lang="en" class="bg-zorba-500">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalURL} />
    )}
    <meta name="viewport" content="width=device-width" />
    <meta name="author" content="Jonathan Geyer" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{formattedTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${person.name}, ${siteName}: ${tagline}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonLd}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@200;400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Continue the color band's loop from the clock, not from zero */}
    <script is:inline define:vars={{ bandDurationMs }}>
      const root = document.documentElement.style
      root.setProperty('--band-duration', `${bandDurationMs}ms`)
      root.setProperty('--band-delay', `${-(Date.now() % bandDurationMs)}ms`)
    </script>
    {/* Apply the saved theme before first paint */}
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.classList.add('theme-light')
        }
      } catch {
        // Storage unavailable: keep the default dark theme
      }
    </script>
    {/* Transition types: slide backwards up the nav order; hero morph to and from Home */}
    <script is:inline define:vars={{ navOrder }}>
      const rank = url => {
        const path = new URL(url).pathname
        return navOrder.indexOf(path.endsWith('/') ? path : path + '/')
      }
      addEventListener('pagereveal', e => {
        const from = window.navigation?.activation?.from?.url
        if (!e.viewTransition || !from) return
        const [fromRank, toRank] = [rank(from), rank(location.href)]
        if (fromRank > toRank) e.viewTransition.types?.add('backwards')
        // Home (first in the nav) morphs its hero into the page header
        if ((fromRank === 0) !== (toRank === 0)) {
          e.viewTransition.types?.add('hero')
        }
      })
    </script>
    {/* Only include Google Analytics in production */}
    {import.meta.env.PROD && (
      <>
        <!-- Google Analytics -->
        <script
          type="text/partytown"
          async
          src="https://www.googletagmanager.com/gtag/js?id=G-W2526JMR42"
        ></script>
        <script type="text/partytown">
          window.dataLayer = window.dataLayer || []
          function gtag() {
            // eslint-disable-next-line prefer-rest-params
            dataLayer.push(arguments)
          }
          gtag('js', new Date())
          gtag('config', 'G-W2526JMR42')
        </script>
      </>
    )}

    <Tooltips interactive={false} delay={[50, 1000]} />
  </head>
  <body class="backing p-0 m-0 relative">
    <div class={formattedStyles}>
      <NavigationMobile />
      {!hero && <Header />}
      <main class="max-w-screen relative z-1 lg:grid lg:grid-cols-site">
        {!hero && <div />}
        <div
          class={
            hero
              ? 'relative w-full lg:col-span-2'
              : 'mx-auto relative max-w-prose'
          }
        >
          <div class="vt-content min-h-[calc(100vh-100px)]">
            <slot />
          </div>
          {!hero && !hidePersonalizer && <Personalizer />}
        </div>
        <NavigationDesktop />
        {<Footer />}
      </main>
      <div class="vt-stats relative w-full border-t-2 sup-border-soft">
        <Stats />
      </div>
    </div>
  </body>
</html>

<style>
  .backing {
    transition: all 1s ease-in-out;
    background: linear-gradient(
      75deg,
      var(--color-zorba-900) 40%,
      var(--color-zorba-100) 60%
    );
    background-position: 0 0;
    background-size: 300% 100%;
  }
  .theme-light .backing {
    background-position: 100% 0;
  }
</style>
