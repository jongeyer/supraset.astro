---
// A page's cycling icons: a row above the content, and on large screens a
// column in the gutter to its left
import MorphCycle from './MorphCycle.astro'
import type { LucideName } from '@/utils/lucide'

interface Props {
  sets: LucideName[][]
  class?: string
}
const { sets, class: className } = Astro.props
---

<div class:list={['page-icons', className]}>
  {sets.map(icons => (
    <MorphCycle icons={icons} />
  ))}
</div>

<style>
  /* A single row whose icons shrink with the space, so it never wraps */
  .page-icons {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 3rem);
    gap: min(0.75rem, 2.5vw);
    margin-bottom: 1rem;
  }
  .page-icons :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  @media (width >= 64rem) {
    /* The content's parent is `relative`; the column sits outside its left edge */
    .page-icons {
      position: absolute;
      top: 20px;
      right: calc(100% + 20px);
      grid-auto-flow: row;
      grid-auto-columns: 3rem;
      gap: 1.25rem;
      margin: 0;
    }
  }
</style>
