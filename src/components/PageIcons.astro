---
// A page's cycling icons: a row above the content, and on large screens a
// column in the gutter to its left
import MorphCycle from './MorphCycle.astro'
import type { LucideName } from '@/utils/lucide'

interface Props {
  sets: LucideName[][]
  class?: string
}
const { sets, class: className } = Astro.props
---

<div class:list={['page-icons', className]}>
  {sets.map(icons => (
    <MorphCycle icons={icons} />
  ))}
</div>

<style>
  .page-icons {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
    font-size: 4.5rem;
  }
  .page-icons :global(svg) {
    display: block;
  }

  @media (width >= 64rem) {
    /* The content's parent is `relative`; the column sits outside its left edge */
    .page-icons {
      position: absolute;
      top: 0;
      right: 100%;
      flex-direction: column;
      gap: 1.5rem;
      margin: 0;
      font-size: 5rem;
    }
  }
</style>
