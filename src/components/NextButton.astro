---
import MorphCycle from './MorphCycle.astro'

interface Props {
  to: string
}
const { to } = Astro.props
---

<a
  href={to}
  class="arrow inline-block text-zorba-50 text-6xl cursor-pointer mx-auto"
  aria-label="About me"
>
  <MorphCycle
    icons={['Shrink', 'Galaxy', 'Asterisk', 'VectorPolygon', 'DoorStairwell']}
  />
</a>

<style>
  .arrow {
    transition: transform 0.2s;
  }

  .arrow:hover {
    animation: wiggle 2.5s ease-in-out infinite;
  }

  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(0deg) scale(1);
    }
    50% {
      transform: rotate(45deg) scale(0.95);
    }
  }
</style>
