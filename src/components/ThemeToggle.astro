---
import MorphIcon from 'morphicons/astro'
import { lucideIcons } from '@/utils/lucide'

// Each side shows its full icon while active and a dimmer one while not
const [moonStar, moon, sun, sunDim] = lucideIcons([
  'MoonStar',
  'Moon',
  'Sun',
  'SunDim',
])
const icons = JSON.stringify({ moonStar, moon, sun, sunDim })
---

<theme-toggle class="inline-block" data-icons={icons}>
  <button class="backing flex border border-zorba-700 rounded-lg p-0 shadow-inner cursor-pointer">
    <span class="sr-only">Dark theme</span>
    <span
      class="dark-toggle relative flex p-2 w-8 h-8 text-base text-zorba-100
      before:content-[''] before:absolute before:z-0 before:inset-0"
    >
      <MorphIcon
        icon={moonStar}
        size="1em"
        spring="snappy"
        reducedMotion="user"
        class="z-1 relative"
        data-theme-icon="dark"
      />
    </span>
    <span class="light-toggle relative flex p-2 w-8 h-8 text-base text-zorba-100">
      <MorphIcon
        icon={sunDim}
        size="1em"
        spring="snappy"
        reducedMotion="user"
        class="z-1 relative"
        data-theme-icon="light"
      />
    </span>
  </button>
</theme-toggle>

<style>
  :global(.theme-light) .dark-toggle::before {
    transform: translateX(100%);
  }
  :global(.theme-light) .dark-toggle,
  :global(html:not(.theme-light)) .light-toggle,
  button[aria-pressed='false'] .light-toggle {
    color: var(--color-zorba-100);
  }

  .backing {
    transition: all 1s ease-in-out;
    background: linear-gradient(
      90deg,
      var(--color-mikan-600) 27%,
      var(--color-mikan-800) 39%,
      var(--color-mikan-800) 66%,
      var(--color-mikan-600) 80%
    );
    background-position: 0% 0;
    background-size: 150% 100%;
  }
  :global(.theme-light) .backing {
    background-position: 100% 0;
  }
</style>

<script>
  import '../types/global.d.ts'
  import type { IconNode } from 'morphicons/astro'
  import type { MorphIconElement } from 'morphicons/element'

  class ThemeToggle extends HTMLElement {
    constructor() {
      super()

      const button = this.querySelector('button')!
      const icons: Record<string, IconNode> = JSON.parse(this.dataset.icons!)
      const darkIcon = this.querySelector<MorphIconElement>(
        '[data-theme-icon="dark"]'
      )!
      const lightIcon = this.querySelector<MorphIconElement>(
        '[data-theme-icon="light"]'
      )!

      /** Show the active side's full icon: morph on a toggle, snap on load. */
      const showIcons = async (light: boolean, animate: boolean) => {
        await customElements.whenDefined('morph-icon')
        const dark = light ? icons.moon : icons.moonStar
        const sun = light ? icons.sun : icons.sunDim
        if (animate) {
          darkIcon.morphTo(dark)
          lightIcon.morphTo(sun)
        } else {
          darkIcon.set(dark)
          lightIcon.set(sun)
        }
      }

      /** Reflect the current theme in this toggle. */
      const sync = (animate: boolean) => {
        const light = this.isDark()
        button.setAttribute('aria-pressed', String(light))
        showIcons(light, animate)
      }

      // The page has a toggle in each nav; every one follows the theme class,
      // whichever toggle changed it
      new MutationObserver(() => sync(true)).observe(document.documentElement, {
        attributeFilter: ['class'],
      })

      // Toggle the theme when a user clicks the button.
      button.addEventListener('click', () => {
        const newTheme = !this.isDark()
        document.documentElement.classList.toggle('theme-light', newTheme)
        try {
          localStorage.setItem('theme', newTheme ? 'light' : 'dark')
        } catch {
          // Storage unavailable: the choice lasts until the next page load
        }

        // Track theme toggle event with GA4
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'theme_toggle', {
            theme: newTheme ? 'light' : 'dark',
          })
        }
      })

      // Initialize button state to reflect current theme.
      sync(false)
    }

    isDark() {
      return document.documentElement.classList.contains('theme-light')
    }
  }
  customElements.define('theme-toggle', ThemeToggle)
</script>
