---
import '../styles/markdown.css'
import type { MixPage } from '@/utils/personalize'

interface Props {
  class?: string
  /** Page id the personalizer may rewrite (see src/utils/personalize.ts) */
  mixable?: MixPage
}
const { class: className, mixable } = Astro.props
---

<article
  class="md-content max-w-prose mx-auto"
  class:list={[className, mixable ? 'mixable' : '']}
  data-mix-page={mixable}
>
  <slot />
</article>
