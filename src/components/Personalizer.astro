---
// Present options to automagically personalize content
import Icon from './Icon.astro'

import { mixStyles } from '@/utils/personalize'

const personalizeOptions = [
  { label: 'Original', value: 'original' },
  ...Object.entries(mixStyles).map(([value, { label }]) => ({ label, value })),
]
const selectedValue = 'original'
---

<div
  class="sticky bottom-0 mx-4 z-60 p-1
  bg-zorba-400/20 backdrop-blur-sm rounded-t-lg shadow-[0_-4px_16px_rgba(0,0,0,0.125)] border border-t-0 border-zorba-500/20"
>
  <button
    id="personalizeButton"
    class="flex items-center mx-auto gap-1.5 py-2 px-3 cursor-pointer opacity-80 mix-blend-difference rounded-lg text-sm font-medium
      text-zorba-500
      transition-all focus:outline-hidden hover:opacity-100 hover:bg-zorba-500/20"
    aria-controls="persOverlay"
    aria-expanded="false"
    title="Try personalizing this page"
  >
    <Icon icon="experiment" size="16px" />
    <span>Experiment with content</span>
  </button>
</div>

<!-- Overlay -->
<div
  id="persOverlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="persTitle"
  inert
  class="fixed inset-20 rounded-lg backdrop-blur-xl bg-black/50 z-101 transition-opacity duration-300 ease-in-out opacity-0 pointer-events-none"
>
  <!-- Close Button -->
  <button
    id="closeButton"
    class="p-2 focus:outline-hidden fixed top-4 right-4 hover:scale-105 transition-all text-zorba-500 hover:text-zorba-300 cursor-pointer"
    aria-label="Close"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="32"
      height="32"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-x"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
      <path d="M18 6l-12 12"></path>
      <path d="M6 6l12 12"></path>
    </svg>
  </button>

  <div class="h-full flex flex-col items-center justify-center">
    <div class="text-xs text-zorba-300 mb-12">
      <p id="persTitle" class="text-center">
        This is a fun experiment with{' '}
        <a
          href="https://openai.com/"
          target="_blank"
          class="text-mikan-600 hover:text-mikan-300"
        >
          OpenAI
        </a>
        .
        <br />
        Select an option to transform content on the page.
      </p>
    </div>
    <ul class="space-y-4 text-left">
      {personalizeOptions.map(option => (
        <li
          class={option.value === selectedValue ? 'opacity-100' : 'opacity-70'}
        >
          <button
            class={`text-2xl flex items-center gap-2 transition-colors ${option.value === selectedValue ? 'selected' : ''}`}
            aria-pressed={option.value === selectedValue ? 'true' : 'false'}
            disabled={option.value === selectedValue}
            data-value={option.value}
          >
            <Icon icon="check" size="24px" />
            {option.label}
          </button>
        </li>
      ))}
    </ul>
  </div>
</div>

<p id="mixStatus" class="sr-only" aria-live="polite"></p>

<style>
  @reference "../styles/base.css";

  .overlay-open {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  #personalizeButton {
    @apply text-mikan-500/80 hover:text-mikan-300;

    &.menu-open {
      @apply bg-mikan-500/20 text-mikan-300;
    }
  }

  li button {
    @apply text-zorba-300 hover:text-zorba-100 cursor-pointer;

    svg {
      opacity: 0;
    }
    &.selected {
      @apply text-mikan-300;

      svg {
        opacity: 1;
      }
    }
    &:hover {
      @apply text-zorba-100;
    }
  }

  :global(.mixing > *) {
    animation: mixing 2s ease-in-out infinite;
    @apply bg-zorba-500/10;
  }
  :global(.mixing > *:nth-child(3n + 1)) {
    /* 1st, 4th, 7th, etc. */
    animation-delay: 0.1s;
  }
  :global(.mixing > *:nth-child(3n + 2)) {
    /* 2nd, 5th, 8th, etc. */
    animation-delay: 0.4s;
  }
  :global(.mixing > *:nth-child(3n)) {
    /* 3rd, 6th, 9th, etc. */
    animation-delay: 0.7s;
  }
  @keyframes mixing {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
    100% {
      opacity: 1;
    }
  }

  :global(.mixed)::after,
  :global(.mix-failed)::after,
  :global(.mixing)::after {
    position: relative;
    top: 0;
    left: 0;
    margin-left: 0.5em;
    padding: 0.25em 0.5em;
    border-radius: 0.25em;
    font-size: 0.675em;
    text-transform: uppercase;
    letter-spacing: 0.75px;
    opacity: 0.75;
    transition: opacity 0.5s ease-in-out;
  }
  :global(.mixed)::after {
    content: 'personalized ✓';
    animation: fadeIn 0.5s ease-in-out both;
    border: 1px solid var(--color-emerald-600);
    color: var(--color-emerald-600);
  }
  :global(.mix-failed)::after {
    content: 'couldn’t personalize, original shown';
    animation: fadeIn 0.5s ease-in-out both;
    border: 1px solid var(--color-red-600);
    color: var(--color-red-600);
  }
  :global(.mixing)::after {
    content: 'Reworking...';
    animation: fadeInOut 2s infinite both;
    border: 1px solid var(--color-mikan-500);
    color: var(--color-mikan-500);
  }
  @keyframes fadeIn {
    0% {
      opacity: 0.5;
    }
    100% {
      opacity: 0.75;
    }
  }
  @keyframes fadeUp {
    0% {
      opacity: 0.75;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes fadeInOut {
    0% {
      opacity: 0.75;
    }
    50% {
      opacity: 0.25;
    }
    100% {
      opacity: 0.75;
    }
  }
</style>

<script>
  import { isMixStyle, matchBlocks, type MixBlock } from '@/utils/personalize'
  import { sanitizeInline } from '@/utils/mix-html'

  const timeoutMs = 35_000

  const personalizeButton = document.getElementById('personalizeButton')
  const closeButton = document.getElementById('closeButton')
  const persOverlay = document.getElementById('persOverlay')
  const status = document.getElementById('mixStatus')
  const options = Array.from(
    document.querySelectorAll<HTMLButtonElement>('#persOverlay [data-value]')
  )
  const article = document.querySelector<HTMLElement>('.mixable')
  const page = article?.dataset.mixPage
  const blockElements = Array.from(
    article?.querySelectorAll<HTMLElement>('[data-mix]') ?? []
  )
  // The page's own markup, restored for "Original" and after any failure
  const originals = new Map(
    blockElements.map(el => [el.dataset.mix!, el.innerHTML])
  )
  const expected: MixBlock[] = Array.from(originals, ([id, html]) => ({
    id,
    html,
  }))

  let isOpen = false
  let pending: AbortController | undefined

  personalizeButton?.addEventListener('click', toggleOverlay)
  closeButton?.addEventListener('click', toggleOverlay)
  persOverlay?.addEventListener('keydown', e => {
    if (e.key === 'Escape') toggleOverlay()
  })
  options.forEach(option => option.addEventListener('click', selectOption))

  function toggleOverlay() {
    isOpen = !isOpen
    personalizeButton?.classList.toggle('menu-open', isOpen)
    personalizeButton?.setAttribute('aria-expanded', String(isOpen))
    persOverlay?.classList.toggle('overlay-open', isOpen)
    persOverlay?.toggleAttribute('inert', !isOpen)
    document.body.style.overflow = isOpen ? 'hidden' : 'auto'

    if (isOpen) {
      options.find(option => !option.disabled)?.focus()
    } else {
      personalizeButton?.focus()
    }

    // Track when overlay is opened
    if (isOpen && typeof window.gtag === 'function') {
      window.gtag('event', 'open_personalization', {
        event_category: 'Engagement',
        event_label: 'Personalize Content',
      })
    }
  }

  function selectOption(e: MouseEvent) {
    const value = (e.currentTarget as HTMLElement).dataset.value
    if (!value) return

    options.forEach(option => {
      const selected = option.dataset.value === value
      option.classList.toggle('selected', selected)
      option.setAttribute('aria-pressed', String(selected))
      option.disabled = selected
    })

    if (isMixStyle(value)) {
      personalizeContent(value)
    } else {
      pending?.abort()
      restoreOriginals()
      setState(null, 'Showing the original text')
    }

    // Track selected personalization option
    if (typeof window.gtag === 'function') {
      window.gtag('event', 'select_personalization', {
        event_category: 'Content',
        event_label: value,
      })
    }

    toggleOverlay()
  }

  function setState(
    state: 'mixing' | 'mixed' | 'mix-failed' | null,
    message: string
  ) {
    article?.classList.remove('mixing', 'mixed', 'mix-failed')
    if (state) article?.classList.add(state)
    if (status) status.textContent = message
  }

  function restoreOriginals() {
    blockElements.forEach(el => {
      el.innerHTML = originals.get(el.dataset.mix!) ?? el.innerHTML
    })
  }

  async function personalizeContent(style: string) {
    // A newer choice replaces any request still in flight
    pending?.abort()
    const controller = new AbortController()
    pending = controller
    const timeout = setTimeout(() => controller.abort('timeout'), timeoutMs)

    setState('mixing', 'Rewriting the page…')

    try {
      const response = await fetch('/.netlify/functions/personalize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ page, style }),
        signal: controller.signal,
      })
      if (!response.ok) {
        throw new Error(`Server responded with ${response.status}`)
      }

      const blocks = matchBlocks(expected, await response.json())
      if (!blocks) throw new Error('Reply did not match the page')

      blocks.forEach(({ id, html }) => {
        const el = blockElements.find(el => el.dataset.mix === id)
        el?.replaceChildren(sanitizeInline(html, originals.get(id)!))
      })
      setState('mixed', 'The page has been personalized')
    } catch (error) {
      // Superseded by a newer choice: that request owns the page now
      if (controller.signal.aborted && controller.signal.reason !== 'timeout') {
        return
      }
      console.error('Personalization failed:', error)
      restoreOriginals()
      setState(
        'mix-failed',
        'Couldn’t personalize the page. Showing the original text.'
      )
    } finally {
      clearTimeout(timeout)
      if (pending === controller) pending = undefined
    }
  }
</script>
