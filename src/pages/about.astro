---
import Layout from '@/layouts/Layout.astro'
import Markdown from '@/components/Markdown.astro'
import PageIcons from '@/components/PageIcons.astro'

import { getEntry, render } from 'astro:content'

const entry = await getEntry('pages', 'about')
let Content
if (entry) {
  Content = (await render(entry)).Content
} else {
  throw new Error('entry is undefined')
}
---

<Layout title={entry.data.title} description={entry.data.description}>
  <div class="relative my-12 px-8">
    <PageIcons
      class="text-mikan-600"
      sets={[
        ['Handshake', 'LayoutDashboard', 'Atom', 'ChartScatter'],
        ['Smile', 'PersonStanding', 'Waves', 'Lightbulb'],
        ['Coffee', 'Users', 'Telescope', 'Puzzle'],
        ['Hand', 'Shapes', 'Palette', 'Layers'],
        ['ShoppingCart', 'GraduationCap', 'Fish', 'BookOpen'],
        ['Brain', 'Eye', 'Scale', 'Sparkles'],
      ]}
    />
    <Markdown mixable="about">
      <Content />
    </Markdown>
  </div>
</Layout>
