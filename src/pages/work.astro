---
import Layout from '@/layouts/Layout.astro'
import Markdown from '@/components/Markdown.astro'
import PageIcons from '@/components/PageIcons.astro'

import { getEntry, render } from 'astro:content'

const entry = await getEntry('pages', 'work')
let Content
if (entry) {
  Content = (await render(entry)).Content
} else {
  throw new Error('entry is undefined')
}
---

<Layout title={entry.data.title} description={entry.data.description}>
  <div class="relative my-12 px-8">
    <PageIcons
      sets={[
        ['Compass', 'DraftingCompass', 'PenTool', 'Orbit'],
        ['Monitor', 'LayoutDashboard', 'ChartLine', 'Map'],
        ['FileCode', 'Database', 'CodeXml', 'Braces'],
        ['Route', 'Users', 'GitBranch', 'Rocket'],
      ]}
    />
    <Markdown mixable="work">
      <Content />
    </Markdown>
  </div>
</Layout>
