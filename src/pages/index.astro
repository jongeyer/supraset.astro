---
import Layout from '@/layouts/Layout.astro'
import NextButton from '@/components/NextButton.astro'
import { tagline } from '@/utils/site'

const description =
  'Jonathan Geyer leads engineering teams building data-rich web applications: dashboards, data management, visualization, and mapping.'
---

<Layout hero description={description}>
  <div class="vt-masthead w-full h-screen colorized grid grid-rows-[6fr_auto_4fr_auto_1fr] gap-y-4 justify-center">
    <div class="row-start-2 px-2 md:px-6 text-center text-zorba-50">
      <h1 class="vt-name w-fit mx-auto leading-none text-4xl sm:text-5xl md:text-6xl font-heading font-bold mb-4">
        Jonathan Geyer
      </h1>
      <div class="vt-tagline w-fit mx-auto leading-none text-lg sm:text-xl md:text-2xl font-heading tracking-[.1em] sm:tracking-[.2em] md:tracking-[.3em] pl-[.1em] sm:pl-[.2em] md:pl-[.3em]">
        S U P R A S E T
      </div>
    </div>
    <div class="vt-hero-next row-start-4 text-center">
      <NextButton to="/about/" />
    </div>
    <div class="vt-hero-tagline row-start-6 text-sm md:text-xl px-4 md:px-6 mb-8 font-heading tracking-wider font-light text-zorba-50 mx-auto drop-shadow-xs">
      {tagline}
    </div>
  </div>
</Layout>

<style>
  .colorized > :global(*) {
    display: inline-block;
    mix-blend-mode: difference;
    -webkit-filter: drop-shadow(0 0 8px rgba(0, 0, 0, 0.85));
  }
</style>
